{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ng-bits": {
      "projectType": "library",
      "root": "projects/ng-bits",
      "sourceRoot": "projects/ng-bits/src",
      "prefix": "ngb",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-bits/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-bits/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ng-bits/tsconfig.spec.json"
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo/public"
              }
            ],
            "styles": ["projects/demo/src/styles.css"],
            "server": "projects/demo/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/demo/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "server": false,
              "ssr": false,
              "outputMode": "static",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "server": false,
              "ssr": false,
              "outputMode": "static",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "ssr": {
              "outputPath": "dist/demo-ssr",
              "browser": "projects/demo/src/main.hydrated.ts",
              "server": "projects/demo/src/main.server.ts",
              "ssr": {
                "entry": "projects/demo/src/server.ts"
              },
              "outputMode": "server"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            },
            "ssr": {
              "buildTarget": "demo:build:development,ssr"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
